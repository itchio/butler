#include "winver.h"
#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define IDI_ICON_S 101

/* Filled in by release/build.js from the git tag; "head" builds get 0,0,0,0 */
#ifndef BUTLER_VERSION_NUM
#define BUTLER_VERSION_NUM 0,0,0,0
#endif
#ifndef BUTLER_VERSION_STR
#define BUTLER_VERSION_STR "head"
#endif

1 VERSIONINFO
FILEVERSION     BUTLER_VERSION_NUM
PRODUCTVERSION  BUTLER_VERSION_NUM
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "itch corp."
      VALUE "FileDescription", "Helper program for the itch app"
      VALUE "FileVersion", BUTLER_VERSION_STR
      VALUE "InternalName", "butler"
      VALUE "LegalCopyright", "itch corp."
      VALUE "OriginalFilename", "butler.exe"
      VALUE "ProductName", "butler"
      VALUE "ProductVersion", BUTLER_VERSION_STR
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

IDI_ICON_S       ICON      "butler.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST MOVEABLE PURE "butler.manifest.xml"
